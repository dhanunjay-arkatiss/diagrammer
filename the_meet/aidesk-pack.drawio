        <mxCell id="t1" value="Data Analyst — in the analyst&#x27;s own browser" style="text;html=1;align=left;verticalAlign=middle;fontSize=33;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="The analyst&#x27;s own files, analysed where they already are. AI-Desk does the thinking; the rows stay in the browser." style="text;html=1;align=left;verticalAlign=middle;fontSize=16.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="66" width="1440" height="22" as="geometry"/></mxCell>
