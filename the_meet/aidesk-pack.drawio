        <mxCell id="client_rule" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#7C8A9C;strokeColor=#7C8A9C;strokeWidth=0;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="4" height="118" as="geometry"/></mxCell>
        <mxCell id="client_t" value="DATA ANALYST" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="128" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="client_n" value="bring your own key (BYOK) — the analyst&#x27;s own key, on their own files" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="84" y="152" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="cc0" value="&lt;b&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:12.5px&#x27;&gt;CSV, XLSX, JSON&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=14.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="84" y="180" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="cc1" value="&lt;b&gt;Tables&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:12.5px&#x27;&gt;a repository, when the question needs one&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=14.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="534" y="180" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="seam" value="" style="html=1;rounded=0;strokeColor=#65717F;strokeWidth=1.5;dashed=1;dashPattern=7 7;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="260" as="sourcePoint"/><mxPoint x="1020" y="260" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seamlabel" value="&lt;b&gt;SEAMS&lt;/b&gt; &amp;nbsp;—&amp;nbsp; the only way in: questions and answers, never your data" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=11.5;align=left;verticalAlign=middle;fontColor=#3E4A58;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="320" y="248" width="440" height="24" as="geometry"/></mxCell>
        <mxCell id="svc" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="960" height="160" as="geometry"/></mxCell>
        <mxCell id="svc_rule" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#7C8A9C;strokeColor=#7C8A9C;strokeWidth=0;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="4" height="160" as="geometry"/></mxCell>
        <mxCell id="svc_t" value="AI-DESK" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="300" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="svc_s0" value="&lt;b&gt;1&lt;/b&gt;   reads the file and profiles every column" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="332" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="svc_s1" value="&lt;b&gt;2&lt;/b&gt;   drafts the SQL and runs it in the browser" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="362" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="svc_s2" value="&lt;b&gt;3&lt;/b&gt;   renders charts and keeps the follow-ups" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="392" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="a_hub" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#62707F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="hub" value="&lt;b&gt;DATAHUB&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:14px&#x27;&gt;only when the analyst points at a table: catalogue and query execution&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#65717F&#x27; style=&#x27;font-size:11.0px&#x27;&gt;repository catalogue · connections · query engine · document corpus · job queue&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#65717F&#x27; style=&#x27;font-size:11.0px&#x27;&gt;on Cloud Run · Cloud SQL (PostgreSQL + pgvector) · Cloud Storage (GCS)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEBACA;strokeWidth=1.5;fontSize=17;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="612" width="960" height="176" as="geometry"/></mxCell>
        <mxCell id="a_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65717F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;entryX=1;entryY=0.62;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="hub" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1046" y="700"/><mxPoint x="1046" y="196"/></Array></mxGeometry></mxCell>
        <mxCell id="notes" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="notes_t" value="What this means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1162" y="128" width="356" height="24" as="geometry"/></mxCell>
        <mxCell id="nb0" value="• &lt;b&gt;Private by default.&lt;/b&gt; Rows never leave the analyst&#x27;s browser." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="164" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb1" value="• &lt;b&gt;Works on what they have.&lt;/b&gt; A spreadsheet is enough to start." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="234" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb2" value="• &lt;b&gt;Charts and follow-ups&lt;/b&gt; in the same conversation." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="304" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb3" value="• &lt;b&gt;Bridge to the estate&lt;/b&gt; when the question needs a real table." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="374" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="stackbox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1140" y="468" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="stack_t" value="TECH STACK" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#65717F;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1162" y="476" width="356" height="20" as="geometry"/></mxCell>
        <mxCell id="stack0" value="· in the browser — TypeScript · React · DuckDB-WASM" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="500" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack1" value="· Cloud Run only for the model proxy" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="540" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack2" value="· bring your own key — the analyst&#x27;s own" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="580" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack_x" value="the instance is ephemeral: stateless, scales to zero" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#65717F;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1162" y="626" width="356" height="22" as="geometry"/></mxCell>
        <mxCell id="foot" value="&lt;b&gt;No long-running agents&lt;/b&gt; — every caller gets an ephemeral instance that dies with the request." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1480" height="24" as="geometry"/></mxCell>
