        <mxCell id="n04" value="&lt;b&gt;The client answers&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:12.5px&#x27;&gt;with its rows&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=14.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1222" y="208" width="262" height="76" as="geometry"/></mxCell>
