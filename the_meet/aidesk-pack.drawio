        <mxCell id="lane1" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="355" width="1480" height="176" as="geometry"/></mxCell>
