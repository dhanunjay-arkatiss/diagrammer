        <mxCell id="t1" value="Enterprise Search — ask, look, infer" style="text;html=1;align=left;verticalAlign=middle;fontSize=33;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="26" width="1200" height="34" as="geometry"/></mxCell>
