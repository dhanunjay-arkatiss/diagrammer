        <mxCell id="seamlabel" value="&lt;b&gt;SEAMS&lt;/b&gt; &amp;nbsp;—&amp;nbsp; the only way in: questions and answers, never your data" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=11.5;align=left;verticalAlign=middle;fontColor=#3E4A58;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="320" y="248" width="440" height="24" as="geometry"/></mxCell>
        <mxCell id="svc" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="960" height="160" as="geometry"/></mxCell>
        <mxCell id="svc_rule" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#7C8A9C;strokeColor=#7C8A9C;strokeWidth=0;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="4" height="160" as="geometry"/></mxCell>
        <mxCell id="svc_t" value="AI-DESK" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="300" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="svc_s0" value="&lt;b&gt;1&lt;/b&gt;   finds the right repository and tables" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="332" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="svc_s1" value="&lt;b&gt;2&lt;/b&gt;   writes the query" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="362" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="svc_s2" value="&lt;b&gt;3&lt;/b&gt;   validates it before anything runs" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="392" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="a_hub" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#62707F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="hub" value="&lt;b&gt;DATAHUB&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:14px&#x27;&gt;runs the query on the source and reflects the rows back&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#65717F&#x27; style=&#x27;font-size:11.0px&#x27;&gt;repository catalogue · connections · query engine · document corpus · job queue&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#65717F&#x27; style=&#x27;font-size:11.0px&#x27;&gt;on Cloud Run · Cloud SQL (PostgreSQL + pgvector) · Cloud Storage (GCS)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEBACA;strokeWidth=1.5;fontSize=17;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="612" width="960" height="176" as="geometry"/></mxCell>
        <mxCell id="a_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65717F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;entryX=1;entryY=0.62;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="hub" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1046" y="700"/><mxPoint x="1046" y="196"/></Array></mxGeometry></mxCell>
        <mxCell id="notes" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="notes_t" value="What this means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1162" y="128" width="356" height="24" as="geometry"/></mxCell>
        <mxCell id="nb0" value="• &lt;b&gt;The agent looks at the data.&lt;/b&gt; DataHub reflects it back; the agent reasons over it." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="164" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb1" value="• &lt;b&gt;Insight, not just rows.&lt;/b&gt; Analysis and charts happen before the client sees anything." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="234" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb2" value="• &lt;b&gt;Documents too.&lt;/b&gt; Contracts and BOL sit in the same experience." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="304" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb3" value="• &lt;b&gt;Nothing lingers.&lt;/b&gt; The instance dies with the request." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="374" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="stackbox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1140" y="468" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="stack_t" value="TECH STACK" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#65717F;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1162" y="476" width="356" height="20" as="geometry"/></mxCell>
        <mxCell id="stack0" value="· Cloud Run — FastAPI · LangGraph" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="500" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack1" value="· Gemini for the reasoning" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="540" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack2" value="· Cloud SQL + pgvector for the built context" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="580" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack_x" value="the instance is ephemeral: stateless, scales to zero" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#65717F;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1162" y="626" width="356" height="22" as="geometry"/></mxCell>
        <mxCell id="foot" value="&lt;b&gt;No long-running agents&lt;/b&gt; — every caller gets an ephemeral instance that dies with the request." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1480" height="24" as="geometry"/></mxCell>
