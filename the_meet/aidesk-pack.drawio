        <mxCell id="client" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="960" height="118" as="geometry"/></mxCell>
        <mxCell id="client_rule" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#7C8A9C;strokeColor=#7C8A9C;strokeWidth=0;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="4" height="118" as="geometry"/></mxCell>
        <mxCell id="client_t" value="EMBEDDED BOT" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="128" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="client_n" value="sits within your product — uses the chatbot builder" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="84" y="152" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="cc0" value="&lt;b&gt;Structured&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:12.5px&#x27;&gt;answers from tables&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=14.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="84" y="180" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="cc1" value="&lt;b&gt;Unstructured&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:12.5px&#x27;&gt;answers from documents&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=14.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="534" y="180" width="430" height="46" as="geometry"/></mxCell>
        <mxCell id="seam" value="" style="html=1;rounded=0;strokeColor=#65717F;strokeWidth=1.5;dashed=1;dashPattern=7 7;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="260" as="sourcePoint"/><mxPoint x="1020" y="260" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seamlabel" value="&lt;b&gt;SEAMS&lt;/b&gt; &amp;nbsp;—&amp;nbsp; the only way in: questions and answers, never your data" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=11.5;align=left;verticalAlign=middle;fontColor=#3E4A58;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="320" y="248" width="440" height="24" as="geometry"/></mxCell>
        <mxCell id="svc" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="960" height="160" as="geometry"/></mxCell>
        <mxCell id="svc_rule" value="" style="rounded=1;arcSize=0;whiteSpace=wrap;html=1;fillColor=#7C8A9C;strokeColor=#7C8A9C;strokeWidth=0;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="4" height="160" as="geometry"/></mxCell>
        <mxCell id="svc_t" value="AI-DESK" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="300" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="svc_s0" value="&lt;b&gt;1&lt;/b&gt;   understands the question in plain English" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="332" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="svc_s1" value="&lt;b&gt;2&lt;/b&gt;   knows which data this bot may touch" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="362" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="svc_s2" value="&lt;b&gt;3&lt;/b&gt;   builds the query from the bot&#x27;s own context" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="84" y="392" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="a_mid" value="the bot takes up the query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#62707F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc" target="bot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bot" value="&lt;b&gt;THE BOT&lt;/b&gt; &amp;nbsp;—&amp;nbsp; takes up the query and runs it on top of DataHub" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E4EAF1;strokeColor=#AEBACA;strokeWidth=1.5;fontSize=15.5;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="486" width="960" height="62" as="geometry"/></mxCell>
        <mxCell id="a_hub" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#62707F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bot" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="hub" value="&lt;b&gt;DATAHUB&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#3E4A58&#x27; style=&#x27;font-size:14px&#x27;&gt;executes against the attached source and returns the rows&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#65717F&#x27; style=&#x27;font-size:11.0px&#x27;&gt;repository catalogue · connections · query engine · document corpus · job queue&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#65717F&#x27; style=&#x27;font-size:11.0px&#x27;&gt;on Cloud Run · Cloud SQL (PostgreSQL + pgvector) · Cloud Storage (GCS)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AEBACA;strokeWidth=1.5;fontSize=17;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="960" height="176" as="geometry"/></mxCell>
        <mxCell id="a_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65717F;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;exitX=1;exitY=0.5;entryX=1;entryY=0.62;fontSize=11.5;fontColor=#3E4A58;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="hub" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1046" y="710"/><mxPoint x="1046" y="196"/></Array></mxGeometry></mxCell>
        <mxCell id="notes" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="notes_t" value="What this means" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1162" y="128" width="356" height="24" as="geometry"/></mxCell>
        <mxCell id="nb0" value="• &lt;b&gt;Configure once.&lt;/b&gt; What the bot answers, and which data it may touch." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="164" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb1" value="• &lt;b&gt;The bot owns the answer.&lt;/b&gt; AI-Desk only builds the query." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="234" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb2" value="• &lt;b&gt;Execution happens on DataHub.&lt;/b&gt; Never on the client, never on the model." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="304" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="nb3" value="• &lt;b&gt;Nothing lingers.&lt;/b&gt; The instance dies with the request." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="374" width="356" height="66" as="geometry"/></mxCell>
        <mxCell id="stackbox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#BCC7D4;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontColor=#111A24;" vertex="1" parent="1"><mxGeometry x="1140" y="468" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="stack_t" value="TECH STACK" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#65717F;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1162" y="476" width="356" height="20" as="geometry"/></mxCell>
        <mxCell id="stack0" value="· Cloud Run — FastAPI · LangGraph" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="500" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack1" value="· Gemini for the reasoning" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="540" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack2" value="· through DataHub — Cloud SQL + pgvector" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#3E4A58;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1162" y="580" width="356" height="36" as="geometry"/></mxCell>
        <mxCell id="stack_x" value="the instance is ephemeral: stateless, scales to zero" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#65717F;spacingLeft=0;spacingRight=0;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1162" y="626" width="356" height="22" as="geometry"/></mxCell>
        <mxCell id="foot" value="&lt;b&gt;No long-running agents&lt;/b&gt; — every caller gets an ephemeral instance that dies with the request." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#111A24;spacingLeft=0;spacingRight=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1480" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
