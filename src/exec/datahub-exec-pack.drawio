        </mxCell>
        <mxCell id="t2" value="Division of responsibility between the platform of record and each capability on top of it" style="text;html=1;fontSize=14;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1000" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="cL" value="DataHub owns — the platform of record" style="swimlane;startSize=36;html=1;rounded=1;fontSize=16;fontStyle=1;fillColor=#B7CDEB;strokeColor=#2F5D8C;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="540" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="ic1" value="•  The repository catalogue — repositories, datasets, tables, columns, descriptions, hints" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="cL">
          <mxGeometry x="10" y="44" width="510" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ic2" value="•  Source connections &amp;amp; the query engine (Oracle · PostgreSQL · BigQuery)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="cL">
          <mxGeometry x="10" y="100" width="510" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ic3" value="•  The document corpus — documents, chunks, headers, entities, relations" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="cL">
          <mxGeometry x="10" y="156" width="510" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ic4" value="•  The ingestion job queue — retries, backoff, dead-letters" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="cL">
          <mxGeometry x="10" y="212" width="510" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ic5" value="•  The content plane — original bytes, page text, images, manifests" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="cL">
          <mxGeometry x="10" y="268" width="510" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ic6" value="•  Build records &amp;amp; the business context of each repository" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="cL">
          <mxGeometry x="10" y="324" width="510" height="52" as="geometry"/>
