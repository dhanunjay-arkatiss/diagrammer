        <mxCell id="s1" value="&lt;b&gt;Structured-data assistant&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ask the data warehouse in plain English.&lt;br&gt;Guided onboarding, then agentic SQL&lt;br&gt;with charts.&lt;br&gt;&lt;small&gt;two services · one MCP server&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5B571;strokeColor=#B45718;fontSize=16;;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="260" height="166" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Document assistant&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ask contracts and business documents.&lt;br&gt;Cited answers, with the page as evidence.&lt;br&gt;&lt;small&gt;an agent edge plus a compute layer&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D591;strokeColor=#45742A;fontSize=16;;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="210" width="260" height="166" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;File-analysis copilot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Analyse tabular files without sending them.&lt;br&gt;The analysis runs in the user&amp;#39;s own browser.&lt;br&gt;&lt;small&gt;browser-native and embeddable&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C7AED9;strokeColor=#5E3B87;fontSize=16;;strokeWidth=2;" vertex="1" parent="1">
