<mxCell id="t1" value="Inside DataHub — one service · capability per application · schema per application" style="text;html=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="30" as="geometry"/></mxCell>

<mxCell id="t2" value="the reference host is the spelling of the contract; the deployed core carries the /metarepository family the Text-SQL services and WebBot-Lite already call" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1240" height="22" as="geometry"/></mxCell>

<mxCell id="hostL" value="capability host — services/datahub :8090 · Java 17 · Spring Boot 3.3.4" style="swimlane;startSize=30;html=1;rounded=1;fontSize=15;fontStyle=1;fillColor=#E3EDF7;strokeColor=#2F5D8C;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="940" height="560" as="geometry"/></mxCell>
