<mxCell id="t2" value="lane A is a one-time setup that builds the context and stores it in DataHub; lane B answers from that stored context — in neither lane does the model see a raw row. Together they are the embedded-chatbot story." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1400" height="22" as="geometry"/></mxCell>
