        <mxCell id="model" value="&lt;b&gt;Model providers&lt;/b&gt;&lt;br&gt;Gemini API · enterprise endpoints&lt;br&gt;&lt;small&gt;called by every assistant — keys stay server-side (the tab uses its own)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C7AED9;strokeColor=#5E3B87;fontSize=14;;strokeWidth=2;" vertex="1" parent="1">
