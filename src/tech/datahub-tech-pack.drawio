<mxCell id="platC" value="platform" style="swimlane;startSize=28;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2F5D8C;" vertex="1" parent="hostL"><mxGeometry x="740" y="40" width="180" height="300" as="geometry"/></mxCell>
<mxCell id="schemagen" value="&lt;b&gt;How the database schema is created&lt;/b&gt; — versioned migration files run automatically when the service starts: one for the build tables (schema ais), one for the corpus tables (schema docuqa — 9 tables, indices, 2 triggers). Nobody creates tables by hand; a change is a new migration file, reviewed like code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="hostL"><mxGeometry x="20" y="392" width="900" height="76" as="geometry"/></mxCell>
<mxCell id="bbr0" value="&lt;b&gt;BuildStoreController&lt;/b&gt; — /api/datahub/*: records · metadata · connections · repos (one endpoint per repository method)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="buildC"><mxGeometry x="10" y="40" width="275" height="64" as="geometry"/></mxCell>
<mxCell id="bbr1" value="&lt;b&gt;BuildStore&lt;/b&gt; — the only SQL in the capability" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="buildC"><mxGeometry x="10" y="104" width="275" height="64" as="geometry"/></mxCell>
<mxCell id="bbr2" value="&lt;b&gt;chat&lt;/b&gt; — /qa-context · /ddl-queries · /context-criteria (ChatStoreController)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="buildC"><mxGeometry x="10" y="168" width="275" height="64" as="geometry"/></mxCell>
<mxCell id="bbr3" value="reads what build writes: records.query + connections.context_criteria" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="buildC"><mxGeometry x="10" y="232" width="275" height="64" as="geometry"/></mxCell>

<mxCell id="ddr0" value="&lt;b&gt;controllers:&lt;/b&gt; Document · Job · Search · Graph · Content — one endpoint per store method" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="docuC"><mxGeometry x="10" y="36" width="355" height="52" as="geometry"/></mxCell>
<mxCell id="ddr1" value="&lt;b&gt;stores:&lt;/b&gt; IngestStore · DocumentStore · NodeStore · HeaderStore · GraphStore · SearchStore · JobStore" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="docuC"><mxGeometry x="10" y="88" width="355" height="52" as="geometry"/></mxCell>
<mxCell id="ddr2" value="&lt;b&gt;coarse transactional endpoints (outbox, ADR-0009):&lt;/b&gt; ingest-submit · persist (idempotent) · purge · jobs/{id}/fail" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="docuC"><mxGeometry x="10" y="140" width="355" height="52" as="geometry"/></mxCell>
<mxCell id="ddr3" value="&lt;b&gt;queue:&lt;/b&gt; claim FOR UPDATE SKIP LOCKED · jittered backoff · dead-letter · lease sweep" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="docuC"><mxGeometry x="10" y="192" width="355" height="52" as="geometry"/></mxCell>
<mxCell id="ddr4" value="&lt;b&gt;content:&lt;/b&gt; LocalContentStore — blobs/{sha256}, corpus/{id}/… · keys validated · purge never deletes blobs" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="docuC"><mxGeometry x="10" y="244" width="355" height="52" as="geometry"/></mxCell>

<mxCell id="ppr0" value="• Observability — RequestLoggingFilter (one line per request)&lt;br&gt;• &lt;b&gt;OpenApiContractTest&lt;/b&gt; — the contract-drift gate&lt;br&gt;• ObjectKeyRules — content-namespace guard&lt;br&gt;• config — StoreProperties · DocuqaProperties" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="platC"><mxGeometry x="10" y="40" width="155" height="240" as="geometry"/></mxCell>




<mxCell id="depL" value="deployed core — dh-repository-backend (Cloud Run)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2F5D8C;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="520" height="330" as="geometry"/></mxCell>

<mxCell id="der0" value="families: /metarepository/list · /list/{repoId} · /summary · &lt;b&gt;/execute&lt;/b&gt; · setcontext · updaterepository" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="depL"><mxGeometry x="10" y="40" width="490" height="56" as="geometry"/></mxCell>
<mxCell id="der1" value="a repository is the record — no per-table artifacts, no embeddings, no per-table build" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="depL"><mxGeometry x="10" y="96" width="490" height="56" as="geometry"/></mxCell>
<mxCell id="der2" value="metaEditJsonData — one JSON &lt;b&gt;string&lt;/b&gt;, possibly double-encoded; read list row + blob together" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="depL"><mxGeometry x="10" y="152" width="490" height="56" as="geometry"/></mxCell>
<mxCell id="der3" value="execute: always HTTP 200 · res_status signals · 30–50 s heavy · no server-side row cap" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="depL"><mxGeometry x="10" y="208" width="490" height="56" as="geometry"/></mxCell>
<mxCell id="der4" value="auth: four headers · no token · no login endpoint · Sessionid is an opaque secret" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="depL"><mxGeometry x="10" y="264" width="490" height="56" as="geometry"/></mxCell>

<mxCell id="mapL" value="the two faces, one map" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#45742A;" vertex="1" parent="1"><mxGeometry x="1020" y="470" width="520" height="210" as="geometry"/></mxCell>

<mxCell id="mar0" value="build (reference style) writes ais rows — repository style instead enriches the repo (setcontext · column desc)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="mapL"><mxGeometry x="10" y="40" width="490" height="56" as="geometry"/></mxCell>
<mxCell id="mar1" value="chat context: reference reads the rows · repository derives it from metaEditJsonData (dialect from source type)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="mapL"><mxGeometry x="10" y="96" width="490" height="56" as="geometry"/></mxCell>
<mxCell id="mar2" value="docuqa contract lives in contracts/openapi/datahub-docuqa.yaml — Java test enforces it on every build" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="mapL"><mxGeometry x="10" y="152" width="490" height="56" as="geometry"/></mxCell>

<mxCell id="pg" value="PostgreSQL 16 + pgvector (schemas ais · docuqa) — migrations are the only DDL; no service holds credentials" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=12;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="420" height="110" as="geometry"/></mxCell>

<mxCell id="cstore" value="content store — CONTENT_STORE_ROOT (volume now, bucket behind the same verbs later)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=12;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="700" width="380" height="110" as="geometry"/></mxCell>

<mxCell id="walls" value="walls: services call HTTP, never the database · the external contract is frozen during refactors · a domain error arrives as HTTP 500 + 200-shaped body — branch on &lt;b&gt;code&lt;/b&gt;, not status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=12;align=left;spacingLeft=12;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="700" width="680" height="110" as="geometry"/></mxCell>

</root></mxGraphModel></diagram>
<diagram id="b3" name="B3 · Text-SQL — three transports">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1122" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t1" value="Text-SQL — one pipeline, three transports" style="text;html=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="0"><mxGeometry x="40" y="18" width="1200" height="30" as="geometry"/></mxCell>
    <mxCell id="t2" value="one repository · two services · one shared spine (ADR-0001) — plus the MCP variant on its own branch, talking DataHub directly (PLAN: no proxy to kind_boyd)" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="0"><mxGeometry x="40" y="50" width="1240" height="22" as="geometry"/></mxCell>
    <mxCell id="nd" value="&lt;b&gt;no-data :8001&lt;/b&gt;&lt;br&gt;FastAPI · builds DDL, criteria &amp;amp; embeddings&lt;br&gt;guided QA — &lt;b&gt;never executes&lt;/b&gt; against the source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5B571;strokeColor=#B45718;fontSize=14;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="110" as="geometry"/></mxCell>
    <mxCell id="yd" value="&lt;b&gt;yes-data :8000&lt;/b&gt;&lt;br&gt;FastAPI · agentic QA (LangGraph + PydanticAI)&lt;br&gt;&lt;b&gt;does execute&lt;/b&gt; · result analysis · charts · streaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5B571;strokeColor=#B45718;fontSize=14;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="330" height="110" as="geometry"/></mxCell>
    <mxCell id="mc" value="&lt;b&gt;MCP :8080&lt;/b&gt;&lt;br&gt;FastMCP · stdio · SSE · streamable-http&lt;br&gt;discovery-first: ask launches from a repo_id alone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5B571;strokeColor=#B45718;fontSize=14;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="330" height="110" as="geometry"/></mxCell>
    <mxCell id="cl" value="HTTP v1/v2/v3 routes (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45718;fontSize=12;dashed=1;dashPattern=6 4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="330" height="44" as="geometry"/></mxCell>
    <mxCell id="c2" value="HTTP v2/v3 + /api/v2/QA/repositories (discovery, user-id header)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45718;fontSize=12;dashed=1;dashPattern=6 4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="252" width="330" height="44" as="geometry"/></mxCell>
    <mxCell id="c3" value="tools: list/get repositories · ask · resume · history · health · prompts · resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45718;fontSize=12;dashed=1;dashPattern=6 4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="252" width="330" height="44" as="geometry"/></mxCell>
    <mxCell id="cap" value="" style="rounded=1;html=1;fillColor=#F4F6FA;strokeColor=#6A7481;strokeWidth=2;pointerEvents=0;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="1100" height="222" as="geometry"/></mxCell>
<mxCell id="capcap" value="capability layer — per service, deliberately not shared (ADR-0004)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;fontColor=#3C4652;" vertex="1" parent="1"><mxGeometry x="52" y="500" width="900" height="26" as="geometry"/></mxCell>
    <mxCell id="cap1" value="features/build_repo — sample records · generated DDL · column notes · semantic context · embedding&lt;br&gt;&lt;small&gt;+ repository_api (metadata · merge · client) for the deployed backend&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45718;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="54" y="342" width="330" height="150" as="geometry"/></mxCell>
    <mxCell id="cap2" value="features/qa_agentic — intent · level routing · schema compression · SQL gen · validation &amp;amp; guardrails · filter/fix agents · summarizer&lt;br&gt;&lt;small&gt;two generations of agents — 31–77 % similar, never merged (measured)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45718;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="434" y="342" width="330" height="150" as="geometry"/></mxCell>
    <mxCell id="cap3" value="the same qa_agentic pipeline (its own copy, own repo)&lt;br&gt;&lt;small&gt;+ DataHub-backed tools/resources: repo://{id}/schema · criteria · metadata · datahub://repositories — questions resolve dialect/connector from the catalogue (config errors, never stack traces)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45718;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="814" y="342" width="310" height="150" as="geometry"/></mxCell>
    <mxCell id="spine" value="shared spine" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#E9ECEE;strokeColor=#2F5D8C;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1100" height="80" as="geometry"/></mxCell>
<mxCell id="spined" value="core (config · db pool · sessions_db · cleanup) · shared · observability · pb stubs · &lt;b&gt;DataHub client (src/core/datahub.py)&lt;/b&gt; — the DATAHUB_API_STYLE switch lives here" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;whiteSpace=wrap;" vertex="1" parent="spine"><mxGeometry x="14" y="34" width="1080" height="40" as="geometry"/></mxCell>
    <mxCell id="faces" value="DataHub — the two faces" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#C8DCEF;strokeColor=#2F5D8C;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1100" height="120" as="geometry"/></mxCell>
    <mxCell id="f1" value="&lt;b&gt;repository style (default)&lt;/b&gt; — /metarepository/* on the deployed backend&lt;br&gt;context is &lt;b&gt;derived&lt;/b&gt; from metaEditJsonData · execute via /metarepository/execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5D8C;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="faces"><mxGeometry x="14" y="42" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="f2" value="&lt;b&gt;reference style&lt;/b&gt; — /api/datahub/* on the bundled Java host&lt;br&gt;context reads the ais rows the build wrote (records.query · connections.context_criteria)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5D8C;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="faces"><mxGeometry x="554" y="42" width="530" height="64" as="geometry"/></mxCell>
    <mxCell id="st1" value="no-data &amp;amp; yes-data: own Postgres — history · conversation_sessions · conversation_state (pgvector)&lt;br&gt;&lt;small&gt;metadata tables are DataHub's by design — the services own only conversations&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=12;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="500" height="120" as="geometry"/></mxCell>
    <mxCell id="st2" value="MCP variant: own Postgres — history + &lt;b&gt;LangGraph checkpoints&lt;/b&gt; · optional Redis sessions&lt;br&gt;&lt;small&gt;degraded startup: Postgres/LLM down ⇒ discovery + health still serve, runtime tools answer with config errors&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=12;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="850" width="460" height="120" as="geometry"/></mxCell>
    <mxCell id="st3" value="&lt;b&gt;observability (both variants)&lt;/b&gt;&lt;br&gt;OpenTelemetry → Tempo 3200 · Prometheus 9090 · Grafana 3000&lt;br&gt;&lt;small&gt;MCP dev: Langfuse sidecar · external calls metered per service/operation&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#6A7481;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1080" y="850" width="460" height="120" as="geometry"/></mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45718;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2;" edge="1" parent="1" source="cl" target="cap1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45718;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2;" edge="1" parent="1" source="c2" target="cap2"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B45718;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2;" edge="1" parent="1" source="c3" target="cap3"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="one seam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#2F5D8C;fontColor=#2F5D8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="cap" target="spine"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="both faces, one switch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#2F5D8C;fontColor=#2F5D8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="spine" target="faces"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>

<diagram id="b4" name="B4 · DocuQA">
<mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1122" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="DocuQA — the public edge · write path · read path · DataHub under all of them" style="text;html=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;" vertex="0" parent="0"><mxGeometry x="40" y="18" width="1300" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="no database of its own (ADR-0014) — three channels only: HTTP+JSON for work · SSE for the user’s tokens · shared storage for bytes &amp;amp; sessions" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="0" parent="0"><mxGeometry x="40" y="50" width="1300" height="22" as="geometry"/></mxCell>
<mxCell id="hc" value="harness :8003 — public edge (Node 22 · pi-agent-core)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#45742A;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="350" height="470" as="geometry"/></mxCell>

<mxCell id="hct" value="• edge/ — the only code that sees untrusted input: auth · CORS · rate limiting&lt;br&gt;&lt;br&gt;• routes — /chat (SSE) · /verify · /conversations (+ pins) · /documents · /jobs; the last two are forwarded &lt;b&gt;verbatim&lt;/b&gt;&lt;br&gt;&lt;br&gt;• agent — &lt;b&gt;12 tools&lt;/b&gt;, a fast/deep/auto mode router, and a &lt;b&gt;citation guard&lt;/b&gt; that matches every figure to a corpus reference&lt;br&gt;&lt;br&gt;• sessions — durable conversation tree, compaction, interrupted-run recovery (own volume, ADR-0013)&lt;br&gt;&lt;br&gt;• llm/ — the only place that calls Gemini&lt;br&gt;&lt;br&gt;• the SSE vocabulary is frozen: update · token · complete · error" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="hc"><mxGeometry x="12" y="38" width="322" height="424" as="geometry"/></mxCell>
<mxCell id="lc" value="library :8001 — write plane (Python 3.13)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#45742A;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="350" height="470" as="geometry"/></mxCell>

<mxCell id="lct" value="• api — validate the upload, hash the bytes, write the blob, then &lt;b&gt;ingest-submit&lt;/b&gt; (which answers 202)&lt;br&gt;&lt;br&gt;• worker — claim a lease → run the pipeline → persist; at-least-once by design&lt;br&gt;&lt;br&gt;• the pipeline does no catalog I/O — it returns a pure BuildResult, so it unit-tests with no DataHub at all&lt;br&gt;&lt;br&gt;• persist replaces nodes, header, mentions and edges atomically — idempotent, safe to retry&lt;br&gt;&lt;br&gt;• everything flows through DataHub's queue and stores: no database of its own" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="lc"><mxGeometry x="12" y="38" width="322" height="424" as="geometry"/></mxCell>
<mxCell id="sc" value="senses :8002 — read plane (Python 3.13)" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#45742A;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="350" height="470" as="geometry"/></mxCell>

<mxCell id="sct" value="• six capabilities, one package each; store.py yields the DataHub adapter for it&lt;br&gt;&lt;br&gt;• hybrid retrieval — vector (halfvec cosine) and lexical (ts_rank_cd) both run &lt;b&gt;in&lt;/b&gt; DataHub; senses fuses them: RRF, coverage rerank, per-document cap&lt;br&gt;&lt;br&gt;• references come from the content plane, under character budgets&lt;br&gt;&lt;br&gt;• contracts/{id}/versions — renewal lineage&lt;br&gt;&lt;br&gt;• graph — a capped BFS (depth ≤ 3, 100 nodes, 500 edges) carrying corpus evidence at every hop&lt;br&gt;&lt;br&gt;• ranks and resolves only — it holds no rows" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="sc"><mxGeometry x="12" y="38" width="322" height="424" as="geometry"/></mxCell>
<mxCell id="dc" value="DataHub — the data plane" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#C8DCEF;strokeColor=#2F5D8C;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="380" height="470" as="geometry"/></mxCell>

<mxCell id="dct" value="• controllers — documents · jobs · search · graph · objects (+ heads)&lt;br&gt;&lt;br&gt;• &lt;b&gt;coarse endpoints&lt;/b&gt;, because the old Python code held a transaction: ingest-submit · persist · purge · jobs/{id}/fail&lt;br&gt;&lt;br&gt;• tables — documents · document_nodes (halfvec 2000) · headers · contracts · entities + aliases (trigram) · relations (evidenced) · jobs&lt;br&gt;&lt;br&gt;• search returns raw-score candidates; fusion deliberately stays in senses&lt;br&gt;&lt;br&gt;• objects — PUT/GET/HEAD/DELETE over bytes, manifest, header, relations, page text and images" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;fontSize=14;whiteSpace=wrap;" vertex="1" parent="dc"><mxGeometry x="12" y="38" width="348" height="424" as="geometry"/></mxCell>
<mxCell id="libs" value="&lt;b&gt;libs&lt;/b&gt; — docuqa_corpus (domain · refs · storage ABC) · docuqa_datahub (transport) — the only shared imports between services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=13;align=left;spacingLeft=12;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1520" height="60" as="geometry"/></mxCell>
<mxCell id="seams" value="&lt;b&gt;seams enforced&lt;/b&gt;: OpenApiContractTest compares Spring mappings with contracts/openapi/datahub-docuqa.yaml on every build · harness SSE contract frozen (additive only) · no broker · no gRPC · no shared imports between services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=13;align=left;spacingLeft=12;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1520" height="70" as="geometry"/></mxCell>
<mxCell id="ar1" value="uploads forwarded verbatim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#45742A;fontColor=#45742A;exitX=1;exitY=0.8;entryX=0;entryY=0.8;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="hc" target="lc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ar2" value="12 JSON tools (SensesClient)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;dashed=1;dashPattern=1 3;strokeColor=#45742A;fontColor=#45742A;exitX=0.5;exitY=0;entryX=0.2;entryY=0;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="hc" target="sc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="104"/><mxPoint x="870" y="104"/></Array></mxGeometry></mxCell>
<mxCell id="ar3" value="rows · queue · objects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#2F5D8C;fontColor=#2F5D8C;exitX=0.75;exitY=0;entryX=0.25;entryY=0;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="lc" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="683" y="96"/><mxPoint x="1475" y="96"/></Array></mxGeometry></mxCell>
<mxCell id="ar4" value="search · graph · content reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#2F5D8C;fontColor=#2F5D8C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="sc" target="dc"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="b5" name="B5 · WebBot-Lite — inside the tab">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1122" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t1" value="WebBot-Lite / analytica — analysis where the data already is" style="text;html=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;html=1;" vertex="0" parent="1"><mxGeometry x="40" y="18" width="1200" height="30" as="geometry"/></mxCell>
    <mxCell id="t2" value="the data never leaves the tab — DuckDB-WASM in a Web Worker, OPFS workspace, localStorage; the same harness runs in a tab, a terminal (CLI) and inside an embed (&amp;lt;quarry-bot&gt;)" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="0" parent="1"><mxGeometry x="40" y="50" width="1400" height="22" as="geometry"/></mxCell>
    <mxCell id="tabz" value="browser tab — the data boundary" style="swimlane;startSize=30;html=1;rounded=1;fontSize=15;fontStyle=1;fillColor=#FFFFFF;strokeColor=#A93226;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="760" height="520" as="geometry"/></mxCell>
    <mxCell id="qb1" value="WebBot-Lite UI (React · thin views over harness events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C7AED9;strokeColor=#5E3B87;fontSize=13;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="tabz"><mxGeometry x="20" y="40" width="720" height="50" as="geometry"/></mxCell>
    <mxCell id="hcore" value="harness (src/harness — UI-agnostic · no DOM · no Node APIs)" style="swimlane;startSize=28;html=1;rounded=1;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#5E3B87;" vertex="1" parent="tabz"><mxGeometry x="20" y="110" width="720" height="150" as="geometry"/></mxCell>
    <mxCell id="hb1" value="datasets + profiles · context crafting · prompts · tools (SQL · charts · code sandbox · JSON · files · workflows) · sessions + compaction" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="hcore"><mxGeometry x="10" y="34" width="700" height="40" as="geometry"/></mxCell>
    <mxCell id="hb2" value="three seams: QueryEngine · KVStore · LlmClient — hosts implement them; the harness only ever sees the interfaces" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="hcore"><mxGeometry x="10" y="84" width="700" height="40" as="geometry"/></mxCell>
    <mxCell id="bhost" value="browser host alone: DuckDB-WASM worker (+ Arrow back) · OPFS virtual workspace · localStorage KV · fetch/HTTP proxy · sandboxed code worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="tabz"><mxGeometry x="20" y="280" width="720" height="60" as="geometry"/></mxCell>
    <mxCell id="capi" value="context documents are files: /workspace/contexts with .discussions sidecars — exportable &amp;amp; versionable · staleness-checked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A7481;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;" vertex="1" parent="tabz"><mxGeometry x="20" y="360" width="350" height="70" as="geometry"/></mxCell>
    <mxCell id="dhconn" value="aidesk face — datahub connector: catalogue → concepts (DDL-teach) → SQL → execute → CSV → local tables; runtime shared by app / aidesk / embed via datahubRuntime.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E3B87;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;dashed=1;dashPattern=6 4;" vertex="1" parent="tabz"><mxGeometry x="390" y="360" width="350" height="70" as="geometry"/></mxCell>
    <mxCell id="eg" value="egress = 2 things: model calls (schema, compact profiles, context, tool results ≤ 50 rows) · aidesk only: catalogue + ONE generated statement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6B9B0;strokeColor=#A93226;fontSize=12;align=left;spacingLeft=10;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="tabz"><mxGeometry x="20" y="450" width="720" height="50" as="geometry"/></mxCell>
    <mxCell id="srv" value="same-origin server — deploy/Dockerfile · nginx + Cloud Run (:8080)" style="swimlane;startSize=28;html=1;rounded=1;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#5E3B87;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="700" height="220" as="geometry"/></mxCell>
    <mxCell id="sv1" value="/api/gemini — model transport server-side (API key or service-account token; GET /api/gemini/status reports mode, never the secret)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="srv"><mxGeometry x="10" y="34" width="680" height="40" as="geometry"/></mxCell>
    <mxCell id="sv2" value="/api/datahub/* — proxy to DataHub: injects the four real headers (browser carries placeholders) · GET /api/datahub/config (no secrets) · loadEnv re-read per request" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="srv"><mxGeometry x="10" y="84" width="680" height="40" as="geometry"/></mxCell>
    <mxCell id="sv3" value="embed hosts: EmbedConfig.datahub = { baseUrl, headers or callback, http?, maxRows } — resolved before every request; placeholders-only lane documented (examples/datahub-portal)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;whiteSpace=wrap;" vertex="1" parent="srv"><mxGeometry x="10" y="134" width="680" height="40" as="geometry"/></mxCell>
    <mxCell id="dh5" value="DataHub — /metarepository/list · /list/{repoId} · /execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7CDEB;strokeColor=#2F5D8C;fontSize=13;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="380" width="700" height="70" as="geometry"/></mxCell>
    <mxCell id="mdl" value="Model providers (server-side transport — the tab may also use its own key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C7AED9;strokeColor=#5E3B87;fontSize=13;whiteSpace=wrap;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="500" width="700" height="60" as="geometry"/></mxCell>
    <mxCell id="g1" value="&lt;b&gt;4 guards&lt;/b&gt;: typed identity validation (pre-network) · aidesk SQL gate — unknown table rejected before DataHub · row cap DATAHUB_MAX_ROWS (1000) · every statement wrapped (ROWNUM / subselect LIMIT), read-oriented — the tenant is shared production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6B9B0;strokeColor=#A93226;fontSize=13;align=left;spacingLeft=12;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1510" height="80" as="geometry"/></mxCell>
    <mxCell id="g2" value="one process per deployment (no second service) · same LlmClient seam → CLI host runs native DuckDB locally · voice: push-to-talk, weights on-device · Langfuse sidecar only in dev (npm run dev:trace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#6A7481;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1510" height="80" as="geometry"/></mxCell>
    <mxCell id="ab1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#5E3B87;fontColor=#5E3B87;exitX=0.97;exitY=1;entryX=1;entryY=0.5;endArrow=block;endFill=1;endSize=6;strokeWidth=2;" edge="1" parent="1" source="tabz" target="srv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="779" y="672"/><mxPoint x="1566" y="672"/><mxPoint x="1566" y="230"/><mxPoint x="1550" y="230"/></Array></mxGeometry></mxCell><mxCell id="ab1_l" value="aidesk calls — the only route from the tab to DataHub" style="edgeLabel;html=1;align=right;verticalAlign=middle;resizable=0;fontSize=13;fontColor=#5E3B87;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="ab1"><mxGeometry x="0.42" y="12" relative="1" as="geometry"/></mxCell>
    <mxCell id="ab2" value="list · execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;strokeColor=#2F5D8C;fontColor=#2F5D8C;exitX=0.5;exitY=1;entryX=0.35;entryY=0;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="srv" target="dh5"><mxGeometry relative="1" as="geometry"/><mxPoint as="sourcePoint"/><mxPoint as="targetPoint"/></mxCell>
    <mxCell id="ab3" value="model calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;dashed=1;dashPattern=1 3;strokeColor=#5E3B87;fontColor=#5E3B87;exitX=0;exitY=0.75;entryX=0;entryY=0.5;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="srv" target="mdl"><mxGeometry x="-0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="300"/><mxPoint x="820" y="530"/></Array></mxGeometry></mxCell>
    <mxCell id="ab4" value="rows → CSV → DuckDB tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;dashed=1;dashPattern=6 4;strokeColor=#A93226;fontColor=#A93226;exitX=0;exitY=0.5;entryX=1;entryY=0.25;;strokeWidth=2;;labelBackgroundColor=#FFFFFF" edge="1" parent="1" source="dh5" target="tabz"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="415"/><mxPoint x="820" y="252"/></Array></mxGeometry></mxCell>
    </root></mxGraphModel>
  </diagram>

<diagram id="b6" name="B6 · The integration contract">
<mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1122" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="The integration contract — what every spoke implements once" style="text;html=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1300" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="the ten rules of docs/DATAHUB.md as client-side obligations — same behaviour in every spoke, verified live (2026-10/11)" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="22" as="geometry"/></mxCell>
<mxCell id="cl" value="one client per codebase, one place for everything — Text-SQL: src/core/datahub.py · DocuQA: libs/docuqa_datahub (+ capability adapters) · WebBot-Lite: src/harness/datahub/client.ts (+ same-origin proxy) — base URL · four headers · envelope · errors · row cap: once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#2F5D8C;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1510" height="70" as="geometry"/></mxCell>
<mxCell id="send" value="send — identity &amp;amp; transport" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2F5D8C;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="490" height="470" as="geometry"/></mxCell>
<mxCell id="send0" value="1. four headers on EVERY call: Sessionid · Tenantid · Tenantorgunitid · Username (case-insensitive — send all four, always)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="send"><mxGeometry x="10" y="36" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="send1" value="2. caller values win, DATAHUB_* env only as fallback — merged in ONE place (datahub_auth_headers) so no client mixes tenants" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="send"><mxGeometry x="10" y="116" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="send2" value="3. validate before the network — missing header = typed DataHubIdentityError, never the service’s Spring 500" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="send"><mxGeometry x="10" y="196" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="send3" value="4. the browser gets placeholders; the server injects the real identity (WebBot-Lite lane) — a rotating session is a one-object change" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="send"><mxGeometry x="10" y="276" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="send4" value="5. timeouts: 30 s reads · 60 s whole-repo writes · 120 s execute" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="send"><mxGeometry x="10" y="356" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="parse" value="parse — envelope &amp;amp; errors" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#A98218;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="490" height="470" as="geometry"/></mxCell>
<mxCell id="parse0" value="1. listings + mutations answer an envelope {code, status, data, pagination} — unwrap data; pagination is 0-based" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="parse"><mxGeometry x="10" y="36" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="parse1" value="2. bare bodies pass through: /execute ({res_status}) · count/jobstatus (array) — check before unwrapping" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="parse"><mxGeometry x="10" y="116" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="parse2" value="3. not found = HTTP 500 + code DH40002 — map to null, not to a transport failure" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="parse"><mxGeometry x="10" y="196" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="parse3" value="4. domain errors arrive as HTTP 500 with a 200-shaped body — branch on &lt;b&gt;code&lt;/b&gt;, never on the status code" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="parse"><mxGeometry x="10" y="276" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="parse4" value="5. res_status: false carries msg (e.g. ORA-00904) — surface it so the model can fix the SQL (DataHubQueryRejected)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="parse"><mxGeometry x="10" y="356" width="466" height="72" as="geometry"/></mxCell>
<mxCell id="guard" value="guard — production discipline" style="swimlane;startSize=30;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#5E3B87;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="470" height="470" as="geometry"/></mxCell>
<mxCell id="guard0" value="1. row cap client-side (1000 default) — there is no server-side cap anywhere" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="guard"><mxGeometry x="10" y="36" width="446" height="72" as="geometry"/></mxCell>
<mxCell id="guard1" value="2. wrap every statement (ROWNUM / subselect+LIMIT) · read-oriented prompts — WebBot-Lite even gates unknown tables before DataHub" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="guard"><mxGeometry x="10" y="116" width="446" height="72" as="geometry"/></mxCell>
<mxCell id="guard2" value="3. treat the tenant as production with real sources attached — snapshot before writes; the DATAHUB.md dry-run / round-trip / revert playbook for whole-repository saves" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="guard"><mxGeometry x="10" y="196" width="446" height="72" as="geometry"/></mxCell>
<mxCell id="guard3" value="4. secrets never enter node properties, logs or exports — they end up embedded in finished artifacts" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="guard"><mxGeometry x="10" y="276" width="446" height="72" as="geometry"/></mxCell>
<mxCell id="guard4" value="5. heavy queries take 30–50 s — patient awaits, streaming where the product needs it" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;whiteSpace=wrap;" vertex="1" parent="guard"><mxGeometry x="10" y="356" width="446" height="72" as="geometry"/></mxCell>
<mxCell id="foot" value="provenance: every rule here was exercised against the live deployment (✅ in docs/DATAHUB.md); ❓ marks catalogue entries never called — the diagrams only draw the verified surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#6A7481;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1510" height="56" as="geometry"/></mxCell>
</root></mxGraphModel>
</diagram>
<diagram id="b7" name="B7 · Ownership matrix">
<mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1122" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="Ownership matrix — every table, one owner" style="text;html=1;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="the invariant: the corpus can be rebuilt from the content plane (not the reverse) · facts trace to a corpus:// ref · sessions never enter DataHub (ADR-0013)" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="22" as="geometry"/></mxCell>
<mxCell id="h0" value="store" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#B7CDEB;strokeColor=#2F5D8C;fontSize=14;fontStyle=1;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="h1" value="schema" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#B7CDEB;strokeColor=#2F5D8C;fontSize=14;fontStyle=1;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="260" height="40" as="geometry"/></mxCell>
<mxCell id="h2" value="owner" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#B7CDEB;strokeColor=#2F5D8C;fontSize=14;fontStyle=1;;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="300" height="40" as="geometry"/></mxCell>
