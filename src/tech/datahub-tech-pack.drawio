        </mxCell>
        <mxCell id="contract" value="&lt;b&gt;Identity &amp;amp; semantics — every call&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. four headers — Sessionid · Tenantid ·&lt;br&gt;Tenantorgunitid · Username&lt;br&gt;2. envelope {code, status, data} — unwrap&lt;br&gt;3. not found = 500 + DH40002 → null&lt;br&gt;4. /execute always HTTP 200 — res_status is the signal&lt;br&gt;5. row cap client-side (1000) · timeout 120 s&lt;br&gt;6. heavy queries 30–50 s — tenant is shared production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE59A;strokeColor=#A98218;fontSize=14;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1220" y="620" width="330" height="310" as="geometry"/>
        </mxCell>
